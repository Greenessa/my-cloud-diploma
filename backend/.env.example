# --- Django ---
# Сгенерируйте ключ командой: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=my_cloud
DB_USER=my_cloud_user
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# --- Storage ---
# Папка для файлов облака (относительно папки backend/)
CLOUD_STORAGE_DIR=storage

# --- Frontend (CORS и CSRF) ---
# Откуда фронтенду разрешено делать запросы к API
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Какие домены доверенные для защиты от CSRF-атак
CSRF_TRUSTED_ORIGINS=http://localhost:5173